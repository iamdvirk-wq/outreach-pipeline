# Copy this file to ".env" (start.sh / start.bat do it for you the first time)
# and fill in the values. Never share .env or commit it to GitHub.

# ---- Your time zone (used for "sent today" and the daily send cap) ----
# Examples: Australia/Brisbane, Australia/Sydney, Australia/Melbourne, Australia/Adelaide, Australia/Perth
TIMEZONE=Australia/Sydney

# ---- Claude (needed from Phase 2) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ---- Google (PageSpeed from Phase 2, Places from Phase 5) ----
# Both can be the same key if you enable both APIs on it.
GOOGLE_PAGESPEED_API_KEY=
GOOGLE_PLACES_API_KEY=

# ---- Sending and reading email (needed from Phase 4) ----
# Gmail / Google Workspace: use an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# ---- Advanced (leave as is) ----
# PORT=8000
# DATABASE_PATH=data/outreach.db
